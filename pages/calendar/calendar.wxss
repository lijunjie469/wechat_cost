.monthbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}
.mnav {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 42rpx;
  color: #07C160;
  background: #FFFFFF;
  border-radius: 50%;
}
.mcenter {
  text-align: center;
}
.mtitle {
  font-size: 32rpx;
  font-weight: 600;
}
.msub {
  font-size: 20rpx;
  color: #9AA0A6;
  margin-top: 2rpx;
}

.cal {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 12rpx 8rpx 16rpx;
}
.week {
  display: flex;
}
.wcell {
  width: 14.28%;
  text-align: center;
  font-size: 20rpx;
  color: #9AA0A6;
  padding: 8rpx 0;
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.cell {
  width: 14.28%;
  min-height: 96rpx;
  padding: 6rpx 2rpx;
  text-align: center;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.cell.blank {
  visibility: hidden;
}
.cell.today .dnum {
  color: #07C160;
  font-weight: 700;
}
.cell.sel {
  background: #EAF9F0;
}
.dnum {
  font-size: 24rpx;
  color: #1A1A1A;
  line-height: 1.4;
}
.dexp {
  font-size: 17rpx;
  color: #5A5E66;
  line-height: 1.3;
  overflow: hidden;
}
.dinc {
  font-size: 17rpx;
  color: #E64340;
  line-height: 1.3;
  overflow: hidden;
}

.daybar {
  display: flex;
  align-items: baseline;
  padding: 8rpx 32rpx 12rpx;
}
.dbdate {
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 14rpx;
}
.dbsum {
  flex: 1;
  font-size: 20rpx;
  color: #9AA0A6;
}
.dblink {
  font-size: 22rpx;
  color: #07C160;
}

.card {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  padding: 20rpx 26rpx;
}
.row.bt {
  border-top: 1rpx solid #F0F1F3;
}
.ricon {
  width: 64rpx;
  height: 64rpx;
  background: #F6F7F9;
  border-radius: 50%;
  text-align: center;
  line-height: 64rpx;
  font-size: 30rpx;
  margin-right: 18rpx;
}
.rmain {
  flex: 1;
  min-width: 0;
}
.rcat {
  font-size: 26rpx;
}
.rnote {
  font-size: 20rpx;
  color: #9AA0A6;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ramt {
  font-size: 28rpx;
  font-weight: 600;
}
.ramt.income {
  color: #E64340;
}
.ramt.transfer {
  color: #6B7280;
  font-weight: 500;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #9AA0A6;
  padding: 60rpx 0;
  font-size: 24rpx;
}
.eicon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.addhere {
  margin: 8rpx 24rpx 40rpx;
  text-align: center;
  padding: 22rpx;
  border-radius: 18rpx;
  border: 1rpx dashed #C8CDD4;
  color: #5A5E66;
  font-size: 26rpx;
}
.addhere-hover {
  background: #F5F6F8;
}
