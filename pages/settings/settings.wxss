.hero {
  background: linear-gradient(135deg, #3A3F47 0%, #1F2329 100%);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  color: #FFFFFF;
}
.hnum {
  font-size: 56rpx;
  font-weight: 700;
}
.hlabel {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}
.hrange {
  font-size: 20rpx;
  opacity: 0.65;
  margin-top: 10rpx;
}

.section {
  margin: 26rpx 32rpx 12rpx;
  font-size: 23rpx;
  color: #9AA0A6;
}

.card {
  background: #FFFFFF;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.card.pad {
  padding: 4rpx 26rpx 20rpx;
}

.srow {
  display: flex;
  align-items: center;
  padding: 26rpx 26rpx;
}
.srow.bt {
  border-top: 1rpx solid #F0F1F3;
}
.srow-hover {
  background: #F5F6F8;
}
.sicon {
  width: 48rpx;
  font-size: 30rpx;
}
.sname {
  flex: 1;
  font-size: 28rpx;
}
.sname.danger {
  color: #E64340;
}
.sarrow {
  color: #C7CBD1;
  font-size: 32rpx;
}

.brow {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}
.brow.bt {
  border-top: 1rpx solid #F0F1F3;
}
.bmain {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.bname {
  font-size: 27rpx;
}
.bsub {
  font-size: 20rpx;
  color: #9AA0A6;
  margin-top: 4rpx;
}
.bbtn {
  font-size: 24rpx;
  color: #07C160;
  background: #EAF9F0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}

.tarea {
  width: 100%;
  height: 220rpx;
  background: #F7F8FA;
  border-radius: 14rpx;
  padding: 18rpx;
  font-size: 22rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}
.trow {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.ghostbtn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #F2F3F5;
  font-size: 24rpx;
  color: #5A5E66;
}
.primarybtn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}
.btn-hover {
  opacity: 0.8;
}

.foot {
  margin: 8rpx 32rpx 48rpx;
  font-size: 20rpx;
  color: #A7ACB4;
  line-height: 1.7;
}
